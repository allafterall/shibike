---
import Button from "./Button.astro";

interface Props {
  buttonText: string;
}

const { buttonText } = Astro.props;
---

<div
  class="px-0 pt-6 bg-gray-300 rounded-2xl flex flex-col justify-center items-center gap-6 relative"
>
  <!-- Temporarily paused notice -->
  <div class="bg-yellow-100 border-2 border-yellow-500 rounded-xl p-4 mx-4 mb-2">
    <p class="text-yellow-900 font-bold text-center text-lg">
      ⚠️ Temporarily Not Taking Orders
    </p>
    <p class="text-yellow-800 text-center text-sm mt-1">
      Bookings are currently paused. Please check back later.
    </p>
  </div>
  
  <div class="opacity-50 cursor-not-allowed pointer-events-none">
    <Button
      text={buttonText}
      variant="primary"
      size="lg"
      href="/book"
    />
  </div>
  <div class="max-w-2xl text-center">
    <slot name="footer" />
  </div>
</div>
